			"updated": 1773829271672,
			"link": null,
			"locked": false,
			"text": "- At-Least-Once — message may be delivered more than once. \n                    \n- At-Most-Once — fire and forget; message may never arrive. \n                                                               \n- Exactly-Once — every message processed exactly one time. ",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "- At-Least-Once — message may be delivered more than once. \n                    \n- At-Most-Once — fire and forget; message may never arrive. \n                                                               \n- Exactly-Once — every message processed exactly one time. ",
			"autoResize": true,
