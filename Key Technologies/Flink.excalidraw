		{
			"id": "9HGlOFfo",
			"type": "text",
			"x": -1270.426401730035,
			"y": 3532.5221040414744,
			"width": 1018.9109497070312,
			"height": 120,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "hachure",
			"strokeWidth": 2,
