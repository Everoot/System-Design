		{
			"id": "gZDxjkRD",
			"type": "text",
			"x": -1270.743958965917,
			"y": -90.73576648153926,
			"width": 857.9512939453125,
			"height": 220,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#1e1e1e",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
