			"seed": 1635570422,
			"version": 96,
			"versionNonce": 1381757046,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775088486700,
			"locked": false,
			"text": "DataStream<ClickEvent> clickstream = env\n    .addSource(new FlinkKafkaConsumer<>(\"clicks\", new JSONDeserializationSchema<>(ClickEvent.class), kafkaProps));\n    \n// Calculate metrics with 1-minute windows\nDataStream<PageViewCount> pageViews = clickstream\n    .keyBy(click -> click.getPageId())\n    .window(TumblingProcessingTimeWindows.of(Time.minutes(1)))\n    .aggregate(new CountAggregator());\n    \n// Write to Redis for dashboard consumption\npageViews.addSink(new RedisSink<>(redisConfig, new PageViewCountMapper()));",
			"rawText": "DataStream<ClickEvent> clickstream = env\n    .addSource(new FlinkKafkaConsumer<>(\"clicks\", new JSONDeserializationSchema<>(ClickEvent.class), kafkaProps));\n    \n// Calculate metrics with 1-minute windows\nDataStream<PageViewCount> pageViews = clickstream\n    .keyBy(click -> click.getPageId())\n    .window(TumblingProcessingTimeWindows.of(Time.minutes(1)))\n    .aggregate(new CountAggregator());\n    \n// Write to Redis for dashboard consumption\npageViews.addSink(new RedisSink<>(redisConfig, new PageViewCountMapper()));",
			"fontSize": 16,
			"fontFamily": 6,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "DataStream<ClickEvent> clickstream = env\n    .addSource(new FlinkKafkaConsumer<>(\"clicks\", new JSONDeserializationSchema<>(ClickEvent.class), kafkaProps));\n    \n// Calculate metrics with 1-minute windows\nDataStream<PageViewCount> pageViews = clickstream\n    .keyBy(click -> click.getPageId())\n    .window(TumblingProcessingTimeWindows.of(Time.minutes(1)))\n    .aggregate(new CountAggregator());\n    \n// Write to Redis for dashboard consumption\npageViews.addSink(new RedisSink<>(redisConfig, new PageViewCountMapper()));",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "Ou9ggD7e",
			"type": "text",
			"x": -1272.8152301512216,
			"y": 230.62791496200475,
			"width": 189.50384521484375,
			"height": 20,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#1e1e1e",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0M",
			"roundness": null,
			"seed": 1939014710,
			"version": 214,
			"versionNonce": 99744234,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775088486700,
			"locked": false,
			"text": "Fraud Detection System",
			"rawText": "Fraud Detection System",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Fraud Detection System",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "CxGgZaY7",
			"type": "text",
			"x": -1274.2563281428272,
			"y": 280.5498030645756,
			"width": 693.0234375,
			"height": 800,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#1e1e1e",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0N",
			"roundness": null,
			"seed": 1582370166,
			"version": 134,
			"versionNonce": 95580598,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775088486700,
			"locked": false,
			"text": "DataStream<Transaction> transactions = env\n    .addSource(new FlinkKafkaConsumer<>(\"transactions\", \n                new KafkaAvroDeserializationSchema<>(Transaction.class), kafkaProps))\n    .assignTimestampsAndWatermarks(\n        WatermarkStrategy.<Transaction>forBoundedOutOfOrderness(Duration.ofSeconds(10))\n            .withTimestampAssigner((event, timestamp) -> event.getTimestamp())\n    );\n    \n// Enrich transactions with account information\nDataStream<EnrichedTransaction> enrichedTransactions = \n    transactions.keyBy(t -> t.getAccountId())\n                .connect(accountInfoStream.keyBy(a -> a.getAccountId()))\n                .process(new AccountEnrichmentFunction());\n\n// Calculate velocity metrics (multiple transactions in short time)\nDataStream<VelocityAlert> velocityAlerts = enrichedTransactions\n    .keyBy(t -> t.getAccountId())\n    .window(SlidingEventTimeWindows.of(Time.minutes(30), Time.minutes(5)))\n    .process(new VelocityDetector(3, 1000.0)); // Alert on 3+ transactions over $1000 in 30 min\n    \n// Pattern detection with CEP for suspicious sequences\nPattern<EnrichedTransaction, ?> fraudPattern = Pattern.<EnrichedTransaction>begin(\"small-tx\")\n    .where(tx -> tx.getAmount() < 10.0)\n    .next(\"large-tx\")\n    .where(tx -> tx.getAmount() > 1000.0)\n    .within(Time.minutes(5));\n    \nDataStream<PatternAlert> patternAlerts = CEP.pattern(\n    enrichedTransactions.keyBy(t -> t.getCardId()), fraudPattern)\n    .select(new PatternAlertSelector());\n    \n// Union all alerts and deduplicate\nDataStream<Alert> allAlerts = velocityAlerts.union(patternAlerts)\n    .keyBy(Alert::getAlertId)\n    .window(TumblingEventTimeWindows.of(Time.minutes(5)))\n    .aggregate(new AlertDeduplicator());\n    \n// Output to Kafka and Elasticsearch\nallAlerts.addSink(new FlinkKafkaProducer<>(\"alerts\", new AlertSerializer(), kafkaProps));\nallAlerts.addSink(ElasticsearchSink.builder(elasticsearchConfig).build());",
			"rawText": "DataStream<Transaction> transactions = env\n    .addSource(new FlinkKafkaConsumer<>(\"transactions\", \n                new KafkaAvroDeserializationSchema<>(Transaction.class), kafkaProps))\n    .assignTimestampsAndWatermarks(\n        WatermarkStrategy.<Transaction>forBoundedOutOfOrderness(Duration.ofSeconds(10))\n            .withTimestampAssigner((event, timestamp) -> event.getTimestamp())\n    );\n    \n// Enrich transactions with account information\nDataStream<EnrichedTransaction> enrichedTransactions = \n    transactions.keyBy(t -> t.getAccountId())\n                .connect(accountInfoStream.keyBy(a -> a.getAccountId()))\n                .process(new AccountEnrichmentFunction());\n\n// Calculate velocity metrics (multiple transactions in short time)\nDataStream<VelocityAlert> velocityAlerts = enrichedTransactions\n    .keyBy(t -> t.getAccountId())\n    .window(SlidingEventTimeWindows.of(Time.minutes(30), Time.minutes(5)))\n    .process(new VelocityDetector(3, 1000.0)); // Alert on 3+ transactions over $1000 in 30 min\n    \n// Pattern detection with CEP for suspicious sequences\nPattern<EnrichedTransaction, ?> fraudPattern = Pattern.<EnrichedTransaction>begin(\"small-tx\")\n    .where(tx -> tx.getAmount() < 10.0)\n    .next(\"large-tx\")\n    .where(tx -> tx.getAmount() > 1000.0)\n    .within(Time.minutes(5));\n    \nDataStream<PatternAlert> patternAlerts = CEP.pattern(\n    enrichedTransactions.keyBy(t -> t.getCardId()), fraudPattern)\n    .select(new PatternAlertSelector());\n    \n// Union all alerts and deduplicate\nDataStream<Alert> allAlerts = velocityAlerts.union(patternAlerts)\n    .keyBy(Alert::getAlertId)\n    .window(TumblingEventTimeWindows.of(Time.minutes(5)))\n    .aggregate(new AlertDeduplicator());\n    \n// Output to Kafka and Elasticsearch\nallAlerts.addSink(new FlinkKafkaProducer<>(\"alerts\", new AlertSerializer(), kafkaProps));\nallAlerts.addSink(ElasticsearchSink.builder(elasticsearchConfig).build());",
			"fontSize": 16,
			"fontFamily": 6,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "DataStream<Transaction> transactions = env\n    .addSource(new FlinkKafkaConsumer<>(\"transactions\", \n                new KafkaAvroDeserializationSchema<>(Transaction.class), kafkaProps))\n    .assignTimestampsAndWatermarks(\n        WatermarkStrategy.<Transaction>forBoundedOutOfOrderness(Duration.ofSeconds(10))\n            .withTimestampAssigner((event, timestamp) -> event.getTimestamp())\n    );\n    \n// Enrich transactions with account information\nDataStream<EnrichedTransaction> enrichedTransactions = \n    transactions.keyBy(t -> t.getAccountId())\n                .connect(accountInfoStream.keyBy(a -> a.getAccountId()))\n                .process(new AccountEnrichmentFunction());\n\n// Calculate velocity metrics (multiple transactions in short time)\nDataStream<VelocityAlert> velocityAlerts = enrichedTransactions\n    .keyBy(t -> t.getAccountId())\n    .window(SlidingEventTimeWindows.of(Time.minutes(30), Time.minutes(5)))\n    .process(new VelocityDetector(3, 1000.0)); // Alert on 3+ transactions over $1000 in 30 min\n    \n// Pattern detection with CEP for suspicious sequences\nPattern<EnrichedTransaction, ?> fraudPattern = Pattern.<EnrichedTransaction>begin(\"small-tx\")\n    .where(tx -> tx.getAmount() < 10.0)\n    .next(\"large-tx\")\n    .where(tx -> tx.getAmount() > 1000.0)\n    .within(Time.minutes(5));\n    \nDataStream<PatternAlert> patternAlerts = CEP.pattern(\n    enrichedTransactions.keyBy(t -> t.getCardId()), fraudPattern)\n    .select(new PatternAlertSelector());\n    \n// Union all alerts and deduplicate\nDataStream<Alert> allAlerts = velocityAlerts.union(patternAlerts)\n    .keyBy(Alert::getAlertId)\n    .window(TumblingEventTimeWindows.of(Time.minutes(5)))\n    .aggregate(new AlertDeduplicator());\n    \n// Output to Kafka and Elasticsearch\nallAlerts.addSink(new FlinkKafkaProducer<>(\"alerts\", new AlertSerializer(), kafkaProps));\nallAlerts.addSink(ElasticsearchSink.builder(elasticsearchConfig).build());",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "rI6z0mFx",
			"type": "text",
			"x": -1299.4044213385494,
			"y": 1144.340976215846,
			"width": 1027.0321027379528,
			"height": 80,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#1e1e1e",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0O",
			"roundness": null,
			"seed": 1862004406,
			"version": 125,
			"versionNonce": 976170154,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775088486700,
			"link": null,
			"locked": false,
			"text": "In this case we're looking for specific patterns that are correlated with fraud: velocity of transactions and specific sequences\nthat are indicative of fraud. We create a stream of alerts and push it to two sinks: one to Kafka for consumption by other\nsystems (maybe an automated system to deactivate an account) and one to Elasticsearch for querying. The net result is a whole\nsystem design in one Flink job",
			"rawText": "In this case we're looking for specific patterns that are correlated with fraud: velocity of transactions and specific sequences that are indicative of fraud. We create a stream of alerts and push it to two sinks: one to Kafka for consumption by other systems (maybe an automated system to deactivate an account) and one to Elasticsearch for querying. The net result is a whole system design in one Flink job",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "In this case we're looking for specific patterns that are correlated with fraud: velocity of transactions and specific sequences that are indicative of fraud. We create a stream of alerts and push it to two sinks: one to Kafka for consumption by other systems (maybe an automated system to deactivate an account) and one to Elasticsearch for querying. The net result is a whole system design in one Flink job",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
