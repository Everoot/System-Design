			"groupIds": [],
			"frameId": null,
			"index": "b14",
			"roundness": null,
			"seed": 1228852022,
			"version": 33,
			"versionNonce": 293924458,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775088486700,
			"locked": false,
			"text": "Task slots serve several purposes:\n    - They isolate memory between tasks.\n    - They control the number of parallel task instances.\n    - They enable resource sharing between different tasks of the same job.\n\nThe net result is each Task Manager has a granular set of atomic resources that can be distributed between jobs and operators.",
			"rawText": "Task slots serve several purposes:\n    - They isolate memory between tasks.\n    - They control the number of parallel task instances.\n    - They enable resource sharing between different tasks of the same job.\n\nThe net result is each Task Manager has a granular set of atomic resources that can be distributed between jobs and operators.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Task slots serve several purposes:\n    - They isolate memory between tasks.\n    - They control the number of parallel task instances.\n    - They enable resource sharing between different tasks of the same job.\n\nThe net result is each Task Manager has a granular set of atomic resources that can be distributed between jobs and operators.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
