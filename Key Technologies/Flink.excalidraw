		{
			"id": "PT9df6si",
			"type": "text",
			"x": -510.3083735086154,
			"y": -4703.222757433604,
			"width": 751.1395263671875,
			"height": 125,
			"angle": 0,
			"strokeColor": "#2f9e44",
			"backgroundColor": "transparent",
