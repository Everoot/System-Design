			"updated": 1775088486700,
			"locked": false,
			"text": "// Example event in a stream\n{\n  \"user_id\": \"123\",\n  \"action\": \"click\",\n  \"timestamp\": \"2024-01-01T00:00:00.000Z\",\n  \"page\": \"/products/xyz\"\n}",
			"rawText": "// Example event in a stream\n{\n  \"user_id\": \"123\",\n  \"action\": \"click\",\n  \"timestamp\": \"2024-01-01T00:00:00.000Z\",\n  \"page\": \"/products/xyz\"\n}",
