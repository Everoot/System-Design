		{
			"id": "5KquwK9h",
			"type": "text",
			"x": -1268.6803562406851,
			"y": -467.42576387446775,
			"width": 1243.2888609681536,
			"height": 120,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#1e1e1e",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0I",
			"roundness": null,
			"seed": 2098679606,
			"version": 299,
			"versionNonce": 458132586,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775088486700,
			"locked": false,
			"text": "Our next step is to submit this job to the Flink cluster to run. This is done by calling the execute method on the StreamExecutionEnvironment (which could\nbe either a local cluster or a remote cluster). When we do this, Flink will:\n- 1. Generate a JobGraph: The Flink compiler transforms your logical data flow (DataStream operations) into an optimized execution plan.\n- 2. Submit to JobManager: The JobGraph is submitted to the JobManager, which serves as the coordinator for your Flink cluster.\n- 3. Distribute Tasks: The JobManager breaks down the JobGraph into tasks and distributes them to TaskManagers.\n- 4. Execute: The TaskManagers execute the tasks, with each task processing a portion of the data.",
			"rawText": "Our next step is to submit this job to the Flink cluster to run. This is done by calling the execute method on the StreamExecutionEnvironment (which could be either a local cluster or a remote cluster). When we do this, Flink will:\n- 1. Generate a JobGraph: The Flink compiler transforms your logical data flow (DataStream operations) into an optimized execution plan.\n- 2. Submit to JobManager: The JobGraph is submitted to the JobManager, which serves as the coordinator for your Flink cluster.\n- 3. Distribute Tasks: The JobManager breaks down the JobGraph into tasks and distributes them to TaskManagers.\n- 4. Execute: The TaskManagers execute the tasks, with each task processing a portion of the data.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Our next step is to submit this job to the Flink cluster to run. This is done by calling the execute method on the StreamExecutionEnvironment (which could be either a local cluster or a remote cluster). When we do this, Flink will:\n- 1. Generate a JobGraph: The Flink compiler transforms your logical data flow (DataStream operations) into an optimized execution plan.\n- 2. Submit to JobManager: The JobGraph is submitted to the JobManager, which serves as the coordinator for your Flink cluster.\n- 3. Distribute Tasks: The JobManager breaks down the JobGraph into tasks and distributes them to TaskManagers.\n- 4. Execute: The TaskManagers execute the tasks, with each task processing a portion of the data.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
