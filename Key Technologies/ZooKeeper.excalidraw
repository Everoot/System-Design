			"roundness": null,
			"seed": 2011158378,
			"version": 588,
			"versionNonce": 361145654,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775169942918,
			"locked": false,
			"text": "Ephemeral ZNodes: \nThese are automatically deleted when the\nsession that created them ends (whether\nthrough client disconnection or timeout). This\nis perfect for tracking which servers are alive\nand which users are online.",
			"rawText": "Ephemeral ZNodes: \nThese are automatically deleted when the session that created them ends (whether through client disconnection or timeout). This is perfect for tracking which servers are alive and which users are online.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Ephemeral ZNodes: \nThese are automatically deleted when the session that created them ends (whether through client disconnection or timeout). This is perfect for tracking which servers are alive and which users are online.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "gSlHpu23",
