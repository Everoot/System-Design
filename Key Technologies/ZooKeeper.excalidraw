		{
			"id": "CDOQmDVt",
			"type": "text",
			"x": -439.746341575064,
			"y": 20275.58565187306,
			"width": 214.22381591796875,
			"height": 20,
			"angle": 0,
			"strokeColor": "#1e1e1e",
