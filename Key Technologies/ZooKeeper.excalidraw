			"isDeleted": false,
			"boundElements": [],
			"updated": 1775169942918,
			"locked": false,
			"text": "Persistent ZNodes: \nThese nodes exist until explicitly deleted. In our\nchat app, we would use persistent nodes for\nconfiguration data like maximum message size or\nrate limiting parameters.",
			"rawText": "Persistent ZNodes: \nThese nodes exist until explicitly deleted. In our chat app, we would use persistent nodes for configuration data like maximum message size or rate limiting parameters.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Persistent ZNodes: \nThese nodes exist until explicitly deleted. In our chat app, we would use persistent nodes for configuration data like maximum message size or rate limiting parameters.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "z83m0lSX",
