			"isDeleted": false,
			"boundElements": [],
			"updated": 1775169942918,
			"locked": false,
			"text": "# Server 2 registers itself when it starts up\ncreate -e /chat-app/servers/server2 \"192.168.1.102:8080\"\n\n# When Bob connects to Server 2, it creates:\ncreate -e /chat-app/users/bob \"server2\"\n\n# If Server 2 crashes, both nodes automatically disappear!",
			"rawText": "# Server 2 registers itself when it starts up\ncreate -e /chat-app/servers/server2 \"192.168.1.102:8080\"\n\n# When Bob connects to Server 2, it creates:\ncreate -e /chat-app/users/bob \"server2\"\n\n# If Server 2 crashes, both nodes automatically disappear!",
			"fontSize": 16,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "# Server 2 registers itself when it starts up\ncreate -e /chat-app/servers/server2 \"192.168.1.102:8080\"\n\n# When Bob connects to Server 2, it creates:\ncreate -e /chat-app/users/bob \"server2\"\n\n# If Server 2 crashes, both nodes automatically disappear!",
			"autoResize": false,
