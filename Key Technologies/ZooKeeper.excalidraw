			"groupIds": [],
			"frameId": null,
			"index": "bAR",
			"roundness": {
				"type": 3
			},
			"seed": 1488542314,
			"version": 761,
			"versionNonce": 1019524854,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775169942919,
			"link": null,
			"locked": false,
			"hasTextLink": false
		},
		{
			"id": "rtuboiRr",
			"type": "text",
			"x": -502.5702910322143,
			"y": 6993.806127186059,
			"width": 971.2290226018505,
			"height": 40,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "hachure",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bAS",
			"roundness": null,
			"seed": 1849064746,
			"version": 560,
			"versionNonce": 1681811510,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775169942919,
			"link": null,
			"locked": false,
			"text": "This ensemble design ensures our critical coordination data—which users are connected to which servers—remains highly\navailable and durable, even when individual ZooKeeper servers fail.",
			"rawText": "This ensemble design ensures our critical coordination data—which users are connected to which servers—remains highly available and durable, even when individual ZooKeeper servers fail.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "This ensemble design ensures our critical coordination data—which users are connected to which servers—remains highly available and durable, even when individual ZooKeeper servers fail.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "HlBKUjFR",
			"type": "text",
			"x": -507.3877664218826,
			"y": 7231.331305976715,
			"width": 390.3197021484375,
			"height": 25,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "hachure",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bAT",
			"roundness": null,
			"seed": 92358634,
			"version": 449,
			"versionNonce": 1810887030,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775169942919,
			"link": null,
			"locked": false,
			"text": "- Watches: Knowing When Things Change",
			"rawText": "- Watches: Knowing When Things Change",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "- Watches: Knowing When Things Change",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "vhgypC7G",
			"type": "text",
			"x": -508.0335548558437,
			"y": 7298.659507929466,
			"width": 1577.0646529948203,
			"height": 40,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "hachure",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bAU",
			"roundness": null,
			"seed": 1722071722,
			"version": 441,
			"versionNonce": 790516406,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775169942919,
			"locked": false,
			"text": "One of ZooKeeper's most powerful features is its watch mechanism, which solves our chat app's notification problem elegantly. Watches allow servers to be notified when a ZNode changes, eliminating\nthe need for constant polling or complex server-to-server communication.",
			"rawText": "One of ZooKeeper's most powerful features is its watch mechanism, which solves our chat app's notification problem elegantly. Watches allow servers to be notified when a ZNode changes, eliminating the need for constant polling or complex server-to-server communication.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "One of ZooKeeper's most powerful features is its watch mechanism, which solves our chat app's notification problem elegantly. Watches allow servers to be notified when a ZNode changes, eliminating the need for constant polling or complex server-to-server communication.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
