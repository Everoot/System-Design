		{
			"id": "Ke952bZC",
			"type": "text",
			"x": -526.7185242937344,
			"y": 10090.657313467194,
			"width": 1598.671142578125,
			"height": 60,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "hachure",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bCB",
			"roundness": null,
			"seed": 636605290,
			"version": 406,
			"versionNonce": 2110515574,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775169942920,
			"locked": false,
			"text": "One of the most common uses of ZooKeeper is to store and distribute configuration data across a distributed system. This might include database connection strings, feature flags, or service endpoints.\n\nIn our chat application, we already saw how we could store configuration values:",
			"rawText": "One of the most common uses of ZooKeeper is to store and distribute configuration data across a distributed system. This might include database connection strings, feature flags, or service endpoints.\n\nIn our chat application, we already saw how we could store configuration values:",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "One of the most common uses of ZooKeeper is to store and distribute configuration data across a distributed system. This might include database connection strings, feature flags, or service endpoints.\n\nIn our chat application, we already saw how we could store configuration values:",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
