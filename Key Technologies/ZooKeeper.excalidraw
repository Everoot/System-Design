		{
			"id": "rDaEmBYq",
			"type": "text",
			"x": -492.15714556912053,
			"y": 14731.889546370172,
			"width": 946.0152587890625,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bCz",
			"roundness": null,
			"seed": 1575699690,
			"version": 493,
			"versionNonce": 1500366518,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775169942921,
			"locked": false,
			"text": "For our chat application, this means when Server 2 registers a new user Bob by creating a ZNode, the following happens:\n1. Server 2 → ZooKeeper Leader: \"Create a ZNode at /chat-app/users/bob with value 'server2'\"\n2. ZooKeeper Leader → All Followers: \"Let's add this new ZNode for Bob\"\n3. Followers → Leader: \"Change accepted and saved\" (majority needed)\n4. Leader → Server 2: \"Bob's ZNode has been created successfully\"",
			"rawText": "For our chat application, this means when Server 2 registers a new user Bob by creating a ZNode, the following happens:\n1. Server 2 → ZooKeeper Leader: \"Create a ZNode at /chat-app/users/bob with value 'server2'\"\n2. ZooKeeper Leader → All Followers: \"Let's add this new ZNode for Bob\"\n3. Followers → Leader: \"Change accepted and saved\" (majority needed)\n4. Leader → Server 2: \"Bob's ZNode has been created successfully\"",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "For our chat application, this means when Server 2 registers a new user Bob by creating a ZNode, the following happens:\n1. Server 2 → ZooKeeper Leader: \"Create a ZNode at /chat-app/users/bob with value 'server2'\"\n2. ZooKeeper Leader → All Followers: \"Let's add this new ZNode for Bob\"\n3. Followers → Leader: \"Change accepted and saved\" (majority needed)\n4. Leader → Server 2: \"Bob's ZNode has been created successfully\"",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
