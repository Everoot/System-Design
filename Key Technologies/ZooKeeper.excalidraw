			"text": "ZooKeeper for Service Discovery",
			"rawText": "ZooKeeper for Service Discovery",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "ZooKeeper for Service Discovery",
