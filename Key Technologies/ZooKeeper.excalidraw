			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "IPPLTIdI",
			"type": "text",
			"x": -527.4798580150659,
			"y": 10968.69235845144,
			"width": 1772.54248046875,
			"height": 60,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "hachure",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bCK",
			"roundness": null,
			"seed": 1635748906,
			"version": 404,
			"versionNonce": 358397110,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1775169942920,
			"locked": false,
			"text": "Service discovery is the process of automatically detecting services and endpoints in a distributed system. As services come online, they register themselves; as they go offline, they deregister (or their ephemeral nodes expire).\n\nWe saw this in action with our chat servers registering themselves:",
			"rawText": "Service discovery is the process of automatically detecting services and endpoints in a distributed system. As services come online, they register themselves; as they go offline, they deregister (or their ephemeral nodes expire).\n\nWe saw this in action with our chat servers registering themselves:",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Service discovery is the process of automatically detecting services and endpoints in a distributed system. As services come online, they register themselves; as they go offline, they deregister (or their ephemeral nodes expire).\n\nWe saw this in action with our chat servers registering themselves:",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "ciTWnyqI",
