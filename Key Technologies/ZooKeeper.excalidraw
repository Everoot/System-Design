		{
			"id": "Jyx5ixZS",
			"type": "text",
			"x": -1195.7112018980783,
			"y": -2402.4747298791563,
			"width": 341.023681640625,
			"height": 40,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "hachure",
			"strokeWidth": 1,
			"strokeStyle": "solid",
