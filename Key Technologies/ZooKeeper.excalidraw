			"text": "create -e /chat-app/servers/server2 \"192.168.1.102:8080\"",
			"rawText": "create -e /chat-app/servers/server2 \"192.168.1.102:8080\"",
			"fontSize": 16,
			"fontFamily": 2,
			"textAlign": "left",
